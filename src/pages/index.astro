---
import { getCollection } from 'astro:content';
import katex from 'katex';
import Layout from '../layouts/Layout.astro';
import LayerMap from '../components/LayerMap.astro';
import { href } from '../utils/paths';

const posts = (await getCollection('posts')).sort((a, b) => a.data.order - b.data.order);
const formula = katex.renderToString(
  String.raw`S_{t+1}=\operatorname{Retain}\!\left(S_t,\ I_t(S_t,E_t);\ V_t\right)`,
  { displayMode: true, throwOnError: true, output: 'htmlAndMathml' }
);
const mechanism = katex.renderToString(String.raw`\mathcal M_{t+1}\ne\mathcal M_t`, {
  throwOnError: true,
  output: 'htmlAndMathml',
});
const insights = [
  {
    number: '01',
    title: '一次优化，会改变下一步值得研究什么。',
    text: 'Flint 的架构、量化与精度恢复，展示了研究优先级怎样随系统变化。',
    anchor: 'bottleneck',
    source: 'FLINT · 瓶颈迁移',
  },
  {
    number: '02',
    title: '生成得更快，可能让一些经验留下来。',
    text: 'Naive 的长轨迹 RL 提示，完成时间可能影响哪些经验进入训练；能力收益仍有条件。',
    anchor: 'experience-speed',
    source: 'NAIVE · 学习机会',
  },
  {
    number: '03',
    title: '经验的价值，取决于怎样留给下一轮。',
    text: 'Recursive 的研究记录与 Apex 的训练反馈，让我区分可修改的具体经验和可迁移的决策规律。',
    anchor: 'memory',
    source: 'RECURSIVE × APEX · 经验积累',
  },
];
---

<Layout
  title="从一次改进到下一轮研究"
  description="从 RSI 的符号定义与 B0–L5 自主权分层出发，理解 Naive、Recursive、Flint 与 Apex 的成果、机制和取舍。"
>
  <div class="shell">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">让一次改进，<br /><span class="accent-underline">进入下一轮研究。</span></h1>
        <p class="hero-intro">从四份研究材料出发，我关心的是：AI 改了什么，什么被留下，又由谁决定下一步怎么改。</p>
        <div class="hero-actions">
          <a class="button-primary" href="#levels">从 B0–L5 开始 <span aria-hidden="true">↗</span></a>
          <a class="text-link" href={href('/insights/')}>先看我的理解 <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <aside class="definition-panel" aria-labelledby="definition-title">
        <h2 id="definition-title">什么被继承，才是关键。</h2>
        <div class="formula" set:html={formula}></div>
        <p>经验促成候选改动，经过验收的改变被保留，成为下一轮的起点。</p>
        <div class="recursion-note">
          <p>进一步形成递归，需要 <span set:html={mechanism}></span>：AI 改进产生下一次改进的方法，并让后继继承、复用。</p>
        </div>
        <details class="notation">
          <summary>展开符号释义</summary>
          <dl>
            <dt>t · 改进轮次</dt>
            <dd>一次提出、验收和保留改变的轮次，不是 token 位置或训练 step。</dd>
            <dt>S<sub>t</sub> · 系统状态</dt>
            <dd>跨轮保留的参数、程序、工具、记忆或策略；不是当前答案本身。</dd>
            <dt>E<sub>t</sub> · 经验</dt>
            <dd>来自任务、环境、先前研究和反馈的信息。</dd>
            <dt>I<sub>t</sub> · 改进器</dt>
            <dd>依据当前状态和经验，提出候选改动。</dd>
            <dt>V<sub>t</sub> · 验收机制</dt>
            <dd>评价候选并应用接受规则；保留不等于真实能力必然提高。</dd>
            <dt>Retain · 保留与继承</dt>
            <dd>将被接受的改变纳入后继状态。下一轮从这里继续。</dd>
            <dt>𝓜<sub>t</sub> · 改进机制</dt>
            <dd>组织改进任务、生成候选、验证与选择改动、生成后继的机制。其变化指实际功能变化，不能用版本号改变代替。</dd>
          </dl>
        </details>
      </aside>
    </section>

    <section class="section" id="levels" aria-labelledby="levels-title">
      <div class="section-heading">
        <div>
          <h2 id="levels-title">B0–L5：AI 自主决定什么？</h2>
        </div>
        <p>选择层级，展开案例与解读。</p>
      </div>
      <LayerMap />
    </section>

    <section class="section" id="cases" aria-labelledby="cases-title">
      <div class="section-heading">
        <div>
          <h2 id="cases-title">成果 → 机制 → 理解与取舍</h2>
        </div>
      </div>
      <div class="case-grid">
        {posts.map((post) => (
          <a class="case-card" href={href(`/posts/${post.id}/`)}>
            <div class="case-top">
              <span class="case-company">{post.data.label}</span>
              <span class="tag">{post.data.level}</span>
            </div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <div class="case-bottom">
              <span>读案例 <span aria-hidden="true">↗</span></span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="section" id="insights" aria-labelledby="insights-title">
      <div class="section-heading">
        <div>
          <h2 id="insights-title">我会带走的三个判断。</h2>
        </div>
        <a class="text-link" href={href('/insights/')}>阅读全部六条 insight <span aria-hidden="true">→</span></a>
      </div>
      <div class="insight-list">
        {insights.map((insight) => (
          <a class="insight-row" href={href(`/insights/#${insight.anchor}`)}>
            <span class="insight-number">{insight.number}</span>
            <div>
              <span class="tiny-label">{insight.source}</span>
              <h3>{insight.title}</h3>
              <p>{insight.text}</p>
            </div>
            <span class="level-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

  </div>
</Layout>
