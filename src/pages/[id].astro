---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import InsightsPage from '../components/InsightsPage.astro';
import { href } from '../utils/paths';
export async function getStaticPaths() { return (await getCollection('pages')).map(entry => ({ params: { id: entry.id }, props: { entry } })); }
interface Props { entry: CollectionEntry<'pages'>; }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter(heading => heading.depth === 2);
---
<Layout title={entry.data.title} description={entry.data.description}>
  {entry.id === 'insights' ? (
    <InsightsPage entry={entry}><Content slot="conclusion" /></InsightsPage>
  ) : (
    <div class="article-shell shell"><nav class="breadcrumb" aria-label="面包屑"><a href={href('/')}>首页</a><span>/</span><span>资料</span></nav><header class="article-header"><h1>{entry.data.title}</h1><p class="article-lead">{entry.data.description}</p></header><div class="article-grid"><article class="prose"><Content /></article><aside class="article-toc"><span class="tiny-label">本页内容</span><ol>{toc.map(h=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol><a class="toc-return" href={href('/#levels')}>← 返回层级地图</a></aside></div></div>
  )}
</Layout>
