---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import '../../styles/case.css';
import { href } from '../../utils/paths';
export async function getStaticPaths() { return (await getCollection('posts')).map(entry => ({ params: { id: entry.id }, props: { entry } })); }
interface Props { entry: CollectionEntry<'posts'>; }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const sections = headings.filter(heading => heading.depth === 2);
const posts = (await getCollection('posts')).sort((a,b)=>a.data.order-b.data.order);
const levelLinks = [{ label: 'L2 · 优化策略', id: 'l2' }];
if (entry.data.level.includes('L3')) {
  levelLinks.push({ label: entry.data.level.includes('线索') ? 'L3 · 经验积累线索' : 'L3 · 经验积累', id: 'l3' });
}
---
<Layout title={entry.data.title} description={entry.data.description}>
  <div class="article-shell shell case-page">
    <nav class="breadcrumb" aria-label="面包屑"><a href={href('/')}>首页</a><span>/</span><a href={href('/#cases')}>研究案例</a><span>/</span><span>{entry.data.label}</span></nav>
    <header class="case-header">
      <div class="case-heading">
        <p class="case-byline">{entry.data.label}</p>
        <h1>{entry.data.title}</h1>
        <p class="case-intro">{entry.data.description}</p>
        <div class="case-source-links">
          {levelLinks.map(level => <a href={href(`/levels/${level.id}/`)}>{level.label}</a>)}
          <a href={entry.data.source}>阅读原文 <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <aside class="case-thesis" aria-label="核心判断">
        <span class="case-thesis-mark" aria-hidden="true">“</span>
        <p>{entry.data.insight}</p>
      </aside>
    </header>

    <dl class="case-metrics" aria-label="关键成果与条件">
      {entry.data.metrics.map(metric => (
        <div class="case-metric">
          <dt>{metric.label}</dt>
          <dd><strong>{metric.value}</strong><span>{metric.context}</span></dd>
        </div>
      ))}
    </dl>

    <nav class="case-section-nav" aria-label="案例章节">
      {sections.map((section, index) => (
        <a href={`#${section.slug}`}><span>{String(index + 1).padStart(2, '0')}</span>{section.text}<span aria-hidden="true">↓</span></a>
      ))}
    </nav>

    <div class="case-layout">
      <article class="prose case-prose"><Content /></article>
      <aside class="case-sidebar" aria-labelledby="takeaways-title">
        <h2 id="takeaways-title">我会带走的判断</h2>
        <ol class="case-takeaways">
          {entry.data.takeaways.map(takeaway => (
            <li><h3>{takeaway.title}</h3><p>{takeaway.text}</p></li>
          ))}
        </ol>
        <a class="case-synthesis-link" href={href('/insights/')}>把四个案例放在一起看 <span aria-hidden="true">↗</span></a>
      </aside>
    </div>

    <nav class="case-related" aria-label="其他研究案例">
      <h2>继续阅读</h2>
      <div>
        {posts.filter(post => post.id !== entry.id).map(post => (
          <a href={href(`/posts/${post.id}/`)}>
            <span>{post.data.label}<span aria-hidden="true">↗</span></span>
            <h3>{post.data.title}</h3>
          </a>
        ))}
      </div>
    </nav>
  </div>
</Layout>
