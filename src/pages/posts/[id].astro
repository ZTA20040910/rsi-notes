---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import FlintWalkthrough from '../../components/FlintWalkthrough.astro';
import { href } from '../../utils/paths';
export async function getStaticPaths() { return (await getCollection('posts')).map(entry => ({ params: { id: entry.id }, props: { entry } })); }
interface Props { entry: CollectionEntry<'posts'>; }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const posts = (await getCollection('posts')).sort((a,b)=>a.data.order-b.data.order);
---
<Layout title={entry.data.title} description={entry.data.description}>
  <div class="article-shell shell">
    <nav class="breadcrumb" aria-label="面包屑"><a href={href('/')}>首页</a><span>/</span><a href={href('/#cases')}>研究案例</a><span>/</span><span>{entry.data.label}</span></nav>
    <header class="article-header"><div class="section-kicker">{entry.data.label}</div><h1>{entry.data.title}</h1><p class="article-lead">{entry.data.description}</p><div class="article-meta"><a class="tag" href={href('/levels/l2/')}>{entry.data.level}</a><a href={entry.data.source}>原文 ↗</a></div></header>
    <div class="article-grid"><article class="prose"><aside class="key-question"><p>{entry.data.insight}</p></aside><Content />{entry.id==='flint' && <FlintWalkthrough />}<div class="related-reading"><h2>继续阅读</h2><div>{posts.filter(p=>p.id!==entry.id).map(p=><a href={href(`/posts/${p.id}/`)}><span>{p.data.label}</span>{p.data.title} ↗</a>)}</div></div></article><aside class="article-toc"><span class="tiny-label">本页内容</span><ol>{headings.filter(h=>h.depth===2).map(h=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}{entry.id==='flint' && <li><a href="#mechanism-heading">机制分步演示</a></li>}</ol><a class="toc-return" href={href('/levels/l2/')}>← 为什么属于 L2</a><a class="toc-return" href={href('/insights/')}>阅读六条 insight ↗</a></aside></div>
  </div>
</Layout>
