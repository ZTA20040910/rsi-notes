---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { href } from '../../utils/paths';
export async function getStaticPaths() { return (await getCollection('levels')).map(entry => ({ params: { id: entry.id }, props: { entry } })); }
interface Props { entry: CollectionEntry<'levels'>; }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const levels = (await getCollection('levels')).sort((a,b) => a.data.order-b.data.order);
const previous = levels[entry.data.order-1];
const next = levels[entry.data.order+1];
---
<Layout title={entry.data.title} description={entry.data.description}>
  <div class="article-shell shell">
    <nav class="breadcrumb" aria-label="面包屑"><a href={href('/')}>首页</a><span>/</span><a href={href('/#levels')}>层级地图</a><span>/</span><span>{entry.data.code}</span></nav>
    <header class="article-header"><div class="section-kicker">THE AUTONOMY MAP / {entry.data.code}</div><h1>{entry.data.title}</h1><p class="article-lead">{entry.data.description}</p><div class="article-meta"><span>{entry.data.evidence}</span><span>依据 survey v3 · 本文机制分析</span></div></header>
    <nav class="level-tabs" aria-label="层级导航">{levels.map(level => <a href={href(`/levels/${level.id}/`)} aria-current={level.id===entry.id?'page':undefined}>{level.data.code}</a>)}</nav>
    <div class="article-grid"><article class="prose"><aside class="key-question"><span class="tiny-label">这一层要回答</span><p>{entry.data.question}</p><small>{entry.data.scope}</small></aside><Content /><nav class="article-neighbors" aria-label="相邻层级"><div>{previous && <a href={href(`/levels/${previous.id}/`)}>← {previous.data.code} · 上一层</a>}</div><div>{next && <a href={href(`/levels/${next.id}/`)}>{next.data.code} · 下一层 →</a>}</div></nav></article><aside class="article-toc"><span class="tiny-label">本页内容</span><ol>{headings.filter(h=>h.depth===2).map(h=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol><a class="toc-return" href={href('/#levels')}>← 返回层级地图</a></aside></div>
  </div>
</Layout>
