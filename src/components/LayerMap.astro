---
import { getCollection } from 'astro:content';
import { href } from '../utils/paths';

const presentation: Record<string, { object: string; relation: string; flow: string[] }> = {
  b0: { object: '当前输出', relation: '任务片段 · 非 RSI 参照', flow: ['执行任务', '读取反馈', '修订输出'] },
  l1: { object: 'Loop · 自主执行', relation: '执行环节', flow: ['人设任务、环境与策略', 'AI 自主执行', '交付结果'] },
  l2: { object: 'P · 当前任务的策略', relation: '策略优化', flow: ['执行与反馈', '发现问题', '调整策略'] },
  l3: { object: 'M · 可复用经验', relation: '经验积累与对照', flow: ['评估行为', '总结并保存经验', '用于下一轮'] },
  l4: { object: 'E · 运行环境与执行状态', relation: '边界对照', flow: ['人设规则与边界', '修改运行条件', '让经验落实到配置'] },
  l5: { object: 'T、R · 任务与研究方法', relation: '边界对照', flow: ['自主安排研究任务', '改进研究方法', '下一代继续使用'] },
};
const caseNames = { naive: 'Naive', 'recursive-first-steps': 'Recursive', flint: 'Flint', apex: 'Apex' };
const layers = (await getCollection('levels')).sort((a, b) => a.data.order - b.data.order).map(entry => ({
  id: entry.id,
  code: entry.data.code,
  title: entry.data.title,
  question: entry.data.question,
  description: entry.data.definition,
  ...presentation[entry.id],
  cases: [
    ...entry.data.cases.map(item => ({
      name: caseNames[item.id],
      relation: item.relation,
      path: href(`/posts/${item.id}/`),
      text: item.meaning,
    })),
    ...(entry.data.examples ?? []).map(item => ({
      name: item.label.split(' · ')[0],
      relation: item.relation,
      path: item.url,
      text: item.observation,
    })),
  ],
}));
---

<div class="layer-explorer" data-layer-explorer>
  <div class="layer-diagram">
    <div class="layer-axis" aria-hidden="true"><span>自主决策范围</span><i></i></div>
    <div class="layer-stack" role="group" aria-label="选择自主权层级">
      {layers.toReversed().map((layer, index) => (
        <div class:list={['layer-step', { 'is-selected': layer.id === 'l2' }]} style={`--step: ${5 - index}`} data-layer-step={layer.id}>
          <a class="layer-select" href={href(`/levels/${layer.id}/`)} data-layer-select={layer.id}>
            <span class="layer-code">{layer.code}</span>
            <span class="layer-label"><strong>{layer.title}</strong><span>{layer.object}</span></span>
            <span class="layer-indicator" aria-hidden="true">↗</span>
          </a>
          <div class="layer-case-strip">
            <span class="layer-relation">{layer.relation}</span>
            {layer.cases.map((item) => <a href={item.path} aria-label={`${layer.code} ${item.relation}：阅读 ${item.name}`}>{item.name}{layer.id === 'l3' && item.relation === '边界对照' ? ' · 对照' : ''}</a>)}
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="layer-details">
    {layers.map((layer) => (
      <section class="layer-panel" id={`layer-panel-${layer.id}`} data-layer-panel={layer.id} hidden={layer.id !== 'l2'} aria-labelledby={`layer-title-${layer.id}`}>
        <div class="layer-panel-top"><span>{layer.code}</span><span>{layer.object}</span></div>
        <h3 id={`layer-title-${layer.id}`}>{layer.question}</h3>
        <p class="layer-description">{layer.description}</p>
        <ol class="layer-flow" aria-label={`${layer.code} 的改进过程`}>
          {layer.flow.map((step) => <li>{step}</li>)}
        </ol>
        <div class="layer-readings">
          <h4>{layer.relation}</h4>
          {layer.cases.map((item) => (
            <a class="layer-reading" href={item.path}>
              <span><strong>{item.name} · {item.relation}</strong><span>{item.text}</span></span>
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
        <a class="layer-deep-link" href={href(`/levels/${layer.id}/`)}>进入 {layer.code} 详细解读 <span aria-hidden="true">→</span></a>
      </section>
    ))}
  </div>
</div>

<script>
  const explorer = document.querySelector<HTMLElement>('[data-layer-explorer]');
  if (explorer) {
    const controls = Array.from(explorer.querySelectorAll<HTMLAnchorElement>('[data-layer-select]'));
    const panels = Array.from(explorer.querySelectorAll<HTMLElement>('[data-layer-panel]'));
    const steps = Array.from(explorer.querySelectorAll<HTMLElement>('[data-layer-step]'));
    const select = (id: string) => {
      controls.forEach((control) => control.setAttribute('aria-pressed', String(control.dataset.layerSelect === id)));
      panels.forEach((panel) => { panel.hidden = panel.dataset.layerPanel !== id; });
      steps.forEach((step) => step.classList.toggle('is-selected', step.dataset.layerStep === id));
    };
    controls.forEach((control, index) => {
      control.setAttribute('role', 'button');
      control.setAttribute('aria-controls', `layer-panel-${control.dataset.layerSelect}`);
      control.addEventListener('click', (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        select(control.dataset.layerSelect!);
        if (event.detail > 0 && window.matchMedia('(max-width: 768px)').matches) {
          const selected = panels.find((panel) => !panel.hidden);
          selected?.scrollIntoView({ block: 'start', behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
        }
      });
      control.addEventListener('keydown', (event) => {
        if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
        let next = index;
        if (event.key === 'ArrowDown') next = (index + 1) % controls.length;
        else if (event.key === 'ArrowUp') next = (index - 1 + controls.length) % controls.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = controls.length - 1;
        else if (event.key !== ' ' && event.key !== 'Enter') return;
        event.preventDefault();
        select(controls[next].dataset.layerSelect!);
        controls[next].focus();
      });
    });
    select('l2');
  }
</script>

<style>
  .layer-explorer { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr); gap: 34px; align-items: start; }
  .layer-diagram { display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: 15px; padding-top: 8px; }
  .layer-axis { position: relative; display: flex; flex-direction: column; align-items: center; gap: 20px; padding: 18px 0; color: var(--muted); }
  .layer-axis span { writing-mode: vertical-rl; font-size: 12px; letter-spacing: .18em; }
  .layer-axis i { position: relative; flex: 1; width: 1px; background: var(--line); }
  .layer-axis i::before { position: absolute; top: 0; left: -3px; width: 7px; height: 7px; content: ''; border-left: 1px solid var(--muted); border-top: 1px solid var(--muted); transform: rotate(45deg); }
  .layer-stack { display: grid; gap: 13px; }
  .layer-step { position: relative; margin-left: calc(var(--step) * 12px); border: 1px solid var(--line); border-radius: 4px; background: var(--card); box-shadow: 0 4px 0 var(--line); transition: border-color .18s, background .18s; }
  .layer-step:hover { border-color: var(--accent); }
  .layer-select { display: grid; grid-template-columns: 48px minmax(0, 1fr) 20px; align-items: center; gap: 12px; padding: 14px 18px 9px; text-decoration: none; }
  .layer-select:hover { color: inherit; }
  .layer-code { color: var(--accent); font: 32px/1 var(--serif); letter-spacing: -.04em; }
  .layer-label { display: flex; flex-wrap: wrap; gap: 3px 14px; align-items: baseline; }
  .layer-label strong { font-size: 16px; font-weight: 600; }
  .layer-label > span { color: var(--muted); font-size: 12px; }
  .layer-indicator { color: var(--muted); font-size: 20px; }
  .layer-case-strip { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 9px; padding: 0 18px 12px; font-size: 11px; }
  .layer-relation { color: var(--muted); }
  .layer-case-strip a { display: inline-flex; align-items: center; min-height: 26px; padding: 0 5px; color: var(--accent); background: var(--panel); border-radius: 2px; text-decoration: none; }
  .layer-case-strip a:hover { text-decoration: underline; }
  .layer-step.is-selected { border-color: var(--accent); background: var(--panel); box-shadow: 0 4px 0 var(--accent); }
  .is-selected .layer-indicator { color: var(--accent); }
  .is-selected .layer-case-strip a { background: var(--card); }
  .layer-step.is-selected::after { position: absolute; right: -7px; top: 24px; width: 12px; height: 12px; content: ''; background: var(--panel); border-top: 1px solid var(--accent); border-right: 1px solid var(--accent); transform: rotate(45deg); }
  .layer-details { min-width: 0; border: 1px solid var(--line); border-top: 3px solid var(--accent); background: var(--card); border-radius: 4px; }
  .layer-panel { padding: 26px; scroll-margin-top: 20px; }
  .layer-panel[hidden] { display: none; }
  .layer-panel-top { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; color: var(--accent); }
  .layer-panel-top > span:first-child { font: 36px/1 var(--serif); }
  .layer-panel-top > span:last-child { padding-left: 12px; border-left: 1px solid var(--line); font-size: 13px; }
  .layer-panel h3 { margin-bottom: 14px; font-size: 28px; line-height: 1.4; }
  .layer-description { margin-bottom: 20px; color: var(--muted); font-size: 14px; line-height: 1.9; }
  .layer-flow { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 17px; margin: 0 0 24px; padding: 0; list-style: none; }
  .layer-flow li { position: relative; display: grid; place-items: center; padding: 9px 4px; background: var(--panel); color: var(--accent); font-size: 12px; text-align: center; line-height: 1.5; }
  .layer-flow li:not(:last-child)::after { content: '→'; position: absolute; right: -15px; color: var(--muted); }
  .layer-readings h4 { margin-bottom: 5px; color: var(--muted); font-size: 12px; font-weight: 500; }
  .layer-reading { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 12px 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .layer-reading strong { color: var(--accent); font-size: 14px; font-weight: 600; }
  .layer-reading > span > span { display: block; color: var(--muted); font-size: 13px; line-height: 1.7; }
  .layer-reading > span:last-child { color: var(--accent); font-size: 20px; }
  .layer-reading:hover strong { text-decoration: underline; text-underline-offset: 4px; }
  .layer-deep-link { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 22px; padding: 12px 16px; background: var(--accent); color: var(--paper); font-size: 13px; text-decoration: none; }
  .layer-deep-link:hover { background: var(--accent-hover); color: var(--paper); }
  @media (max-width: 1000px) {
    .layer-explorer { gap: 24px; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .layer-diagram { grid-template-columns: 14px minmax(0, 1fr); gap: 9px; }
    .layer-step { margin-left: calc(var(--step) * 6px); }
    .layer-select { padding-inline: 12px; grid-template-columns: 38px minmax(0, 1fr) 18px; gap: 8px; }
    .layer-case-strip { padding-inline: 12px; }
    .layer-panel { padding: 22px; }
    .layer-panel h3 { font-size: 25px; }
  }
  @media (max-width: 768px) {
    .layer-explorer { grid-template-columns: 1fr; gap: 25px; }
    .layer-step { margin-left: calc(var(--step) * 12px); }
    .layer-details { scroll-margin-top: 20px; }
    .layer-step.is-selected::after { display: none; }
  }
  @media (max-width: 480px) {
    .layer-step { margin-left: calc(var(--step) * 6px); }
    .layer-select { padding-top: 11px; }
    .layer-label strong { font-size: 15px; }
    .layer-label > span { display: none; }
    .layer-code { font-size: 29px; }
    .layer-case-strip { font-size: 11px; gap: 4px 7px; padding-bottom: 10px; }
    .layer-panel { padding: 20px; }
    .layer-panel h3 { font-size: 24px; }
  }
</style>
