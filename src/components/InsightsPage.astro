---
import type { CollectionEntry } from 'astro:content';
import { href } from '../utils/paths';
import ExperienceSelection from './ExperienceSelection.astro';
import VerificationQuestions from './VerificationQuestions.astro';
import '../styles/insights.css';

interface Props { entry: CollectionEntry<'pages'>; }
const { entry } = Astro.props;
if (!entry.data.insights || !entry.data.chapters) throw new Error('The insights page requires its chapters and arguments.');
const insights = entry.data.insights;
const chapters = entry.data.chapters;
const byId = new Map(insights.map(insight => [insight.id, insight]));
const chapterIds = chapters.flatMap(chapter => chapter.insightIds);
if (chapterIds.length !== insights.length || new Set(chapterIds).size !== insights.length || chapterIds.some(id => !byId.has(id))) {
  throw new Error('Every insight must appear in exactly one chapter.');
}
---

<div class="article-shell shell insights-page">
  <nav class="breadcrumb" aria-label="面包屑"><a href={href('/')}>首页</a><span>/</span><span>我的理解</span></nav>
  <header class="insights-heading">
    <h1>{entry.data.title}</h1>
    <p>{entry.data.description}</p>
  </header>

  <nav class="insights-overview" id="insights-overview" aria-label="效率、数据、验收与积累的阅读主线">
    <ol class="insights-route">
      {chapters.map(chapter => (
        <li><a href={`#${chapter.id}`}>
          <span class="insights-map-label"><span>{chapter.number}</span>{chapter.label}<span aria-hidden="true">↘</span></span>
          <strong>{chapter.title}</strong>
        </a></li>
      ))}
    </ol>
  </nav>

  <div class="insights-chapters">
    {chapters.map(chapter => (
      <section class="insight-chapter" id={chapter.id} aria-labelledby={`chapter-title-${chapter.id}`}>
        <header class="insight-chapter-heading">
          <div><span>{chapter.number} · {chapter.label}</span><h2 id={`chapter-title-${chapter.id}`}>{chapter.title}</h2></div>
          <p>{chapter.intro}</p>
        </header>
        <div class="insight-essays">
          {chapter.insightIds.map(id => {
            const insight = byId.get(id)!;
            return (
              <article class="insight-essay" id={insight.id} aria-labelledby={`insight-title-${insight.id}`}>
                <header class="insight-essay-header">
                  <span class="insight-index" aria-hidden="true">{insight.number}</span>
                  <div><h3 id={`insight-title-${insight.id}`}>{insight.title}</h3><p>{insight.thesis}</p></div>
                </header>
                <div class="insight-argument">
                  <div class="insight-evidence">
                    <h4>材料依据</h4>
                    <p>{insight.evidence}</p>
                    <div class="insight-source-links">
                      {insight.sources.map(source => <a href={source.url}>{source.label} <span aria-hidden="true">↗</span></a>)}
                    </div>
                  </div>
                  <div class="insight-reasoning">
                    <h4>推理过程</h4>
                    <ol>{insight.reasoning.map(step => <li>{step}</li>)}</ol>
                  </div>
                </div>
                <div class="insight-choice"><h4>我的取舍</h4><p>{insight.choice}</p></div>
                {insight.id === 'experience-speed' && <ExperienceSelection />}
                {insight.id === 'verification' && <VerificationQuestions />}
                {insight.elaboration && (
                  <details class="insight-elaboration" id={`${insight.id}-followup`}>
                    <summary>{insight.elaboration.title}</summary>
                    <div>
                      {insight.elaboration.paragraphs.map(paragraph => <p>{paragraph}</p>)}
                      <div class="insight-source-links">{insight.elaboration.sources.map(source => <a href={source.url}>{source.label} <span aria-hidden="true">↗</span></a>)}</div>
                    </div>
                  </details>
                )}
                <div class="insight-connections" aria-label="与其他判断的联系">
                  {insight.connections.map(connection => {
                    const related = byId.get(connection.id)!;
                    return (
                      <a href={`#${related.id}`}>
                        <span>{related.number} · {related.label}<span aria-hidden="true">↗</span></span>
                        <p>{connection.text}</p>
                      </a>
                    );
                  })}
                </div>
                <footer class="insight-essay-footer">
                  <div>{insight.cases.map(item => <a href={href(`/posts/${item.id}/`)}>{item.label} 案例 <span aria-hidden="true">↗</span></a>)}</div>
                  <a href="#insights-overview" aria-label={`从${insight.label}返回阅读主线`}>回到主线 <span aria-hidden="true">↑</span></a>
                </footer>
              </article>
            );
          })}
        </div>
      </section>
    ))}
  </div>

  <section class="insights-conclusion" aria-labelledby="insights-conclusion-title">
    <h2 id="insights-conclusion-title">如果只继续追问一件事</h2>
    <div><slot name="conclusion" /></div>
    <nav aria-label="继续阅读"><a href="#efficiency">带着新经验，再看下一步怎么选 <span aria-hidden="true">↑</span></a><a href={href('/#levels')}>回到 B0–L5 <span aria-hidden="true">↗</span></a><a href={href('/references/')}>参考资料 <span aria-hidden="true">↗</span></a></nav>
  </section>
</div>
